APP_NAME="John Lee Calulut — Portfolio"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Database ---------------------------------------------------------------
# Default stack: MySQL. Create the database, then run `php artisan migrate --seed`.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=portfolio
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database
QUEUE_CONNECTION=database

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Mail (optional: used if you later email yourself on new contact messages)
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Admin panel ------------------------------------------------------------
# Credentials seeded for the /admin login (see DatabaseSeeder).
# CHANGE THIS PASSWORD before deploying anywhere public.
ADMIN_NAME="John Lee Calulut"
ADMIN_EMAIL=admin@johncalulut.dev
ADMIN_PASSWORD=password
